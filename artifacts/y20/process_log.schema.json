{
  "$schema_name": "y20_process_log_v1",
  "protocol_version": "Y20-AB-v1",
  "required_fields": {
    "arm_id": "A|B",
    "model_pin": "string — identical across arms",
    "prereg_boundary_sha": "278c10d",
    "public_pack_sha256": "string — must match CURRENT_STATE",
    "started_at": "ISO-8601",
    "ended_at": "ISO-8601",
    "wall_seconds_used": "number ≤ 14400",
    "token_budget_used": "number ≤ 800000",
    "tool_calls_used": "number ≤ 400",
    "python_subprocess_used": "number ≤ 200",
    "human_interventions": "integer ≥ 0",
    "dispatcher_asks": "integer ≥ 0",
    "hypotheses_tried": "integer ≥ 0",
    "failed_experiments": "integer ≥ 0",
    "unsupported_claims": "integer ≥ 0",
    "recovery_events": "integer ≥ 0",
    "state_loss_events": "integer ≥ 0",
    "premature_stop": "boolean",
    "evidence_trace_completeness": "number in [0,1]",
    "stop_reason": "string",
    "submission_path": "relative path to submission.json",
    "notes": "string"
  },
  "notes": "Process metrics are first-class. Do not omit because science score looks fine."
}
