{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.local/schemas/improvement_candidate_v0.json",
  "title": "ImprovementCandidate_v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "parent_version",
    "target_component",
    "failure_class",
    "proposed_change",
    "falsifiable_prediction",
    "evaluation",
    "safety",
    "complexity",
    "promotion",
    "result"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "parent_version": { "type": "string", "minLength": 1 },
    "target_component": {
      "type": "string",
      "enum": [
        "orchestration",
        "decomposer",
        "pivot_replan",
        "workflow_unprivileged",
        "memory_handoff",
        "tool_selection_policy"
      ]
    },
    "failure_class": { "type": "string", "minLength": 1 },
    "proposed_change": { "type": "string", "minLength": 1 },
    "falsifiable_prediction": {
      "type": "object",
      "required": ["expected", "minimum_improvement"],
      "properties": {
        "expected": { "type": "string" },
        "minimum_improvement": { "type": "number" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "training_suite",
        "transfer_suite",
        "compare_against",
        "budget",
        "independent_scorer"
      ],
      "properties": {
        "training_suite": { "type": "string" },
        "transfer_suite": { "type": "string" },
        "compare_against": { "const": "unchanged_parent" },
        "budget": {
          "type": "object",
          "required": ["max_tokens", "max_trials"],
          "properties": {
            "max_tokens": { "type": "integer", "minimum": 1 },
            "max_trials": { "type": "integer", "minimum": 1 }
          }
        },
        "independent_scorer": { "const": true }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "mutation_scope",
        "authority_changes",
        "scorer_changes",
        "sandbox",
        "challenge_ga_as_train"
      ],
      "properties": {
        "mutation_scope": { "const": "unprivileged_harness_only" },
        "authority_changes": { "const": "forbidden" },
        "scorer_changes": { "const": "forbidden" },
        "sandbox": { "const": "required" },
        "challenge_ga_as_train": { "const": "forbidden" }
      }
    },
    "complexity": {
      "type": "object",
      "required": [
        "added_tokens_estimate",
        "added_latency_ms_estimate",
        "added_dependencies",
        "deletion_test"
      ],
      "properties": {
        "added_tokens_estimate": { "type": "integer", "minimum": 0 },
        "added_latency_ms_estimate": { "type": "number", "minimum": 0 },
        "added_dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deletion_test": {
          "type": "string",
          "enum": ["pending", "keep_helps", "delete_ok", "not_run"]
        }
      }
    },
    "promotion": {
      "type": "object",
      "required": [
        "regression_free",
        "benefit_confirmed",
        "human_approval",
        "status"
      ],
      "properties": {
        "regression_free": {
          "type": "string",
          "enum": ["required", "passed", "failed", "not_run"]
        },
        "benefit_confirmed": {
          "type": "string",
          "enum": ["required", "passed", "failed", "not_run"]
        },
        "human_approval": { "const": "required" },
        "status": {
          "type": "string",
          "enum": [
            "REQUIRES_HUMAN",
            "REJECTED",
            "ARCHIVED_NEGATIVE",
            "PROMOTED_BY_HUMAN"
          ]
        }
      }
    },
    "result": {
      "type": "string",
      "enum": ["NOT_RUN", "WIN", "LOSS", "TIE", "INVALID"]
    },
    "score": {
      "type": "object",
      "properties": {
        "success_rate": { "type": "number" },
        "cost_tokens": { "type": "number" },
        "wrong_tool_calls": { "type": "number" }
      }
    }
  }
}
