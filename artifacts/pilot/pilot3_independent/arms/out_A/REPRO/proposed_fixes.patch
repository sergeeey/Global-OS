@@ -175,10 +175,19 @@ def _run_semgrep(
             observed=observed,
         )
 
-    status = "pass" if completed.returncode == 0 else "fail"
+    # Semgrep uses exit 1 when findings exist; SARIF parsing decides block levels.
+    # Only treat other non-zero codes as runner failures (tool/config errors).
+    if completed.returncode not in (0, 1):
+        return CheckResult(
+            name="semgrep.run",
+            status="fail",
+            message=f"semgrep completed with exit code {completed.returncode}",
+            observed=observed,
+        )
+
     return CheckResult(
         name="semgrep.run",
-        status=status,
+        status="pass",
         message=f"semgrep completed with exit code {completed.returncode}",
         observed=observed,
     )
@@ -213,10 +222,20 @@ def _run_trufflehog(
         "returncode": completed.returncode,
         "output_path": str(output_path),
     }
-    status = "pass" if completed.returncode == 0 else "fail"
+    # Non-zero often means findings were emitted. Finding policy is enforced by
+    # _check_trufflehog_jsonl (including block_trufflehog_unknown). Fail the
+    # runner only when the process produced no usable output (crash/timeout).
+    if completed.returncode != 0 and not completed.stdout.strip():
+        return CheckResult(
+            name="trufflehog.run",
+            status="fail",
+            message=f"trufflehog completed with exit code {completed.returncode} and empty output",
+            observed=observed,
+        )
+
     return CheckResult(
         name="trufflehog.run",
-        status=status,
+        status="pass",
         message=f"trufflehog completed with exit code {completed.returncode}",
         observed=observed,
