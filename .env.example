# Global OS — free-tier live keys (copy to a local path OUTSIDE git, then source/load).
# Never commit real keys. Do not paste keys into chat.
#
# Recommended local path (Windows):
#   E:\...\secret\.env
# Or repo-local (gitignored):
#   .env.local
#
# Load (Git Bash / WSL):
#   set -a && source "/path/to/secret/.env" && set +a
#
# Load (PowerShell):
#   Get-Content 'E:\path\secret\.env' | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -match '^\s*$') { return }
#     $line = $_ -replace '^\s*export\s+',''
#     $k,$v = $line -split '=',2
#     Set-Item -Path ("Env:" + $k.Trim()) -Value ($v.Trim().Trim('"').Trim("'"))
#   }
#
# Verify WITHOUT printing secrets:
#   python -c "from global_os.adapters.models import live_keys_present; print(live_keys_present())"

GOS_ZERO_COST_MODE=1
OPENROUTER_API_KEY=
