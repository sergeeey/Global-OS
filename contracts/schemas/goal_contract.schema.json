{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/goal_contract.schema.json",
  "title": "GoalContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "version",
    "tenant_id",
    "workspace_id",
    "objective",
    "success_criteria",
    "invariants",
    "non_goals",
    "forbidden_outcomes",
    "risk",
    "authority",
    "created_at",
    "schema_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "goal_id": { "type": "string", "minLength": 1, "pattern": "^goal_[a-zA-Z0-9_\\-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_outcomes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tolerance", "maximum_irreversibility"],
      "properties": {
        "tolerance": { "type": "string", "enum": ["none", "low", "moderate", "high"] },
        "maximum_irreversibility": { "type": "string", "enum": ["none", "low", "moderate", "high"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_depth_max", "capabilities"],
      "properties": {
        "delegation_depth_max": { "type": "integer", "minimum": 0, "maximum": 32 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" }
        }
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_tier"],
        "properties": {
          "verification_tier": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starts_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "reconfirm_after": { "type": "string", "minLength": 1 }
      }
    },
    "termination": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "supersedes_version": { "type": "integer", "minimum": 1 },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposer": { "type": "string" },
        "reason": { "type": "string" },
        "changed_fields": { "type": "array", "items": { "type": "string" } },
        "authority_ref": { "type": "string" },
        "approval_ref": { "type": "string" },
        "impact_analysis": { "type": "string" }
      }
    },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
