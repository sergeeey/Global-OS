{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/environment_policy.schema.json",
  "title": "EnvironmentPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "goal_id",
    "allowed_sandbox_profiles",
    "max_reasoning_budget",
    "default_verification_tier"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^epol_[a-zA-Z0-9_\\-]+$" },
    "schema_version": { "type": "string", "const": "0.1.0" },
    "goal_id": { "type": "string" },
    "allowed_sandbox_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["none", "process_local", "container", "gvisor", "microvm"]
      }
    },
    "max_reasoning_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "usd", "wall_time_seconds"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "wall_time_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "default_verification_tier": { "type": "integer", "minimum": 0, "maximum": 4 },
    "forbid_network": { "type": "boolean" }
  }
}
