{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/clarification_policy.schema.json",
  "title": "ClarificationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["materiality_policy", "ask_when", "assume_when", "record_assumption"],
  "properties": {
    "materiality_policy": {
      "type": "string",
      "enum": ["never", "high_impact_only", "ambiguous_constraints", "always_uncertain", "materiality_based"]
    },
    "ask_when": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "missing_success_criteria",
          "conflicting_invariants",
          "authority_gap",
          "irreversible_action",
          "budget_ambiguous",
          "external_commitment",
          "goal_interpretation_changes",
          "result_materially_changes",
          "authority_boundary_unclear"
        ]
      }
    },
    "assume_when": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["formatting_only", "reversible", "low_impact", "evidence_can_resolve_later"]
      }
    },
    "record_assumption": { "type": "boolean" },
    "max_rounds": { "type": "integer", "minimum": 0, "maximum": 20 }
  }
}
