{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/clarification_policy.schema.json",
  "title": "ClarificationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["materiality_policy", "ask_when"],
  "properties": {
    "materiality_policy": {
      "type": "string",
      "enum": ["never", "high_impact_only", "ambiguous_constraints", "always_uncertain"]
    },
    "ask_when": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "missing_success_criteria",
          "conflicting_invariants",
          "authority_gap",
          "irreversible_action",
          "budget_ambiguous",
          "external_commitment"
        ]
      }
    },
    "max_rounds": { "type": "integer", "minimum": 0, "maximum": 20, "default": 3 }
  }
}
