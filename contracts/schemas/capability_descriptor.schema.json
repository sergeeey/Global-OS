{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/capability_descriptor.schema.json",
  "title": "CapabilityDescriptor",
  "description": "Volatile capability registry entry — not stable core, not world fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "kind",
    "provider",
    "implementation",
    "risk",
    "verified_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^cap_[a-zA-Z0-9_\\-\\.]+$" },
    "schema_version": { "type": "string", "const": "0.1.0" },
    "kind": { "type": "string", "enum": ["model", "tool", "sandbox", "retrieval", "evaluator"] },
    "provider": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "input_contract": { "type": "string" },
    "output_contract": { "type": "string" },
    "risk": { "type": "string", "enum": ["none", "low", "moderate", "high", "critical"] },
    "cost_usd_per_unit": { "type": "number", "minimum": 0 },
    "latency_ms_p50": { "type": "number", "minimum": 0 },
    "reliability": { "type": "number", "minimum": 0, "maximum": 1 },
    "verified_at": { "type": "string", "format": "date-time" },
    "compatible_models": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Fine-grained capability tags (web.read, reasoning, coding, …)"
    },
    "role": { "type": "string" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "free_tier": { "type": "boolean" },
        "training_allowed": {
          "type": ["string", "boolean"],
          "description": "possible|denied|unknown or boolean"
        },
        "zero_data_retention": { "type": "boolean" },
        "retention": { "type": "string" }
      }
    },
    "scientific_use": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinned": { "type": "boolean" },
        "smoke_router_ok": { "type": "boolean" }
      }
    }
  }
}
