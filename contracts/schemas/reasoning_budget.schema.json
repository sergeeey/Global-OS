{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/reasoning_budget.schema.json",
  "title": "ReasoningBudget",
  "type": "object",
  "additionalProperties": false,
  "required": ["requested", "maximum", "policy_source"],
  "properties": {
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "usd", "wall_time_seconds"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "wall_time_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "maximum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "usd", "wall_time_seconds"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "wall_time_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "policy_source": {
      "type": "string",
      "enum": ["goal_contract", "org_unit", "environment_policy", "human_override"]
    }
  }
}
