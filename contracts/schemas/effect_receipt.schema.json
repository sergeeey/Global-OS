{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-os.dev/schemas/effect_receipt.schema.json",
  "title": "EffectReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "schema_version",
    "action_id",
    "tool_response",
    "intended_effect",
    "observed_effect",
    "discrepancy",
    "verified_at",
    "verification_method"
  ],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^er_[a-zA-Z0-9_\\-]+$" },
    "schema_version": { "type": "string", "const": "0.1.0" },
    "action_id": { "type": "string", "minLength": 1 },
    "tool_response": {
      "type": "object",
      "required": ["success"],
      "properties": {
        "success": { "type": "boolean" },
        "status_code": { "type": "integer" },
        "raw_ref": { "type": "string" }
      }
    },
    "intended_effect": { "type": "string", "minLength": 1 },
    "observed_effect": { "type": "string", "minLength": 1 },
    "discrepancy": { "type": "string" },
    "verified_at": { "type": "string", "format": "date-time" },
    "verification_method": { "type": "string", "minLength": 1 },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "EXECUTED",
        "OBSERVATION_PENDING",
        "RECONCILED",
        "DISCREPANCY",
        "ESCALATION_REQUIRED",
        "COMPENSATION_REQUIRED"
      ]
    },
    "world_success": { "type": "boolean" }
  }
}
